{
  "name": "smart-price-matcher",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "node -r ./scripts/register-ts.cjs tests/run-all-tests.ts",
    "test:e2e": "playwright test",
    "preflight": "node scripts/preflight.cjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node -r ./scripts/register-ts.cjs prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "next": "^16.3.5",
    "next-auth": "^4.24.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3"
  }
}
