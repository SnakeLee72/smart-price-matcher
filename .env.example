# Local PostgreSQL (Docker Compose publishes port 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_price_matcher?schema=public"
ENABLE_PRICE_PERSISTENCE="false"
ENABLE_CONNECTOR_LOGS="false"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional server-side token for administrative API actions. Set a random value in production.
ADMIN_API_TOKEN=""
# Generate a persistent random value (for example: openssl rand -base64 32).
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Optional OAuth providers. Leave empty to use isolated anonymous guest sessions.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_ENTRA_ID_CLIENT_ID=""
MICROSOFT_ENTRA_ID_CLIENT_SECRET=""
MICROSOFT_ENTRA_ID_TENANT_ID=""
